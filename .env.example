# Server-only settings. Do not prefix these with NEXT_PUBLIC_.
# Set the region and model/inference profile available to YOUR AWS account.
AWS_REGION=
BEDROCK_MODEL_ID=

# Optional local alternative: a short-term Bedrock key generated in this region.
# Paste the value ONLY into .env.local. It expires with the console session.
AWS_BEARER_TOKEN_BEDROCK=

# AWS credentials are resolved by the SDK's default credential chain.
# For local development, sign in using an AWS CLI profile / IAM Identity Center.
# For AWS deployment, attach a least-privilege IAM role instead.
# Never commit access keys or paste them into source code.
